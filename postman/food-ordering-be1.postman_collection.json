              "raw": "{\n  \"username\": \"kh_{{suffix}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"CUSTOMER\",\n  \"fullName\": \"Khách Test\",\n  \"email\": \"kh{{suffix}}@example.com\",\n  \"phone\": \"09{{suffix}}\",\n  \"address\": \"Hà Nội\"\n}"
